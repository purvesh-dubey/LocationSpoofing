<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location: needed to read back what the system reports, and to run a location-type foreground service. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The map downloads OpenStreetMap tiles. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The 1-second mock loop lives in a foreground service so Android doesn't kill it in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- API 33+: required to show the ongoing "Mock location active" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MockGpsLabApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MockGpsLab">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          foregroundServiceType="location" must match the FOREGROUND_SERVICE_LOCATION permission above.
          Not exported: only this app (and the notification's own PendingIntent) may start or stop it.
        -->
        <service
            android:name=".service.MockLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
